rules_version = '2';

// CBC Sport Broadcast — Firestore təhlükəsizlik qaydaları
// - İşçilər (anonim giriş) yalnız qrafikləri OXUYA bilər.
// - Yükləmə / yeniləmə / silmə yalnız serverdə "admin: true" Custom Claim-i olan hesaba açıqdır.
//   Claim yalnız Firebase Admin SDK ilə təyin olunur (admin-tools/set-admin.mjs); tətbiq onu dəyişə bilməz.
// - Başqa heç bir kolleksiyaya giriş yoxdur.
// Yayımlamazdan əvvəl: docs/ADMIN.md → "Qaydaları yoxlamaq".

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Sənəd id-si: main_2026-10-27_2026-11-01 və ya operator_2026-11-02_2026-11-08
    function validId(id) {
      return id.matches('^(main|operator)_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validSchedule() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'period', 'fileName', 'total', 'data', 'uploadedAt', 'uploadedBy'])
        && d.keys().hasAll(['type', 'period', 'fileName', 'total', 'data', 'uploadedAt', 'uploadedBy'])
        && d.type in ['main', 'operator']
        && d.period is list && d.period.size() == 2
        && d.period[0] is string && d.period[1] is string
        && d.fileName is string && d.fileName.size() <= 200
        && d.total is int && d.total >= 1 && d.total <= 5000
        && d.data is string && d.data.size() <= 900000
        && d.uploadedAt == request.time
        && d.uploadedBy == request.auth.uid;
    }

    match /schedules/{scheduleId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin() && validId(scheduleId) && validSchedule();
      allow delete: if isAdmin();
    }

    // Push bildirişi üçün cihaz tokeni: hər istifadəçi yalnız ÖZ sənədini yaza/silə bilər, heç kim oxuya bilməz.
    // Tokenləri yalnız server (Cloud Function, Admin SDK) oxuyur.
    match /devices/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'team', 'updatedAt'])
        && request.resource.data.keys().hasAll(['token', 'platform', 'team', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20 && request.resource.data.token.size() < 4096
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.team in ['sts', 'operator']
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // notifications/{versiya} — yalnız server istifadə edir (aşağıdakı ümumi qadağa ilə bağlıdır)

    // Qalan hər şey bağlıdır
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
